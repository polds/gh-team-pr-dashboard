{
	"name": "PR Review Radar",
	"description": "Read-only board of open pull requests and whose turn it is. Never reviews, comments, or merges.",
	"url": "https://radar.internal.example.com",
	"public": false,
	"hook_attributes": {
		"url": "https://radar-hooks.example.com/webhooks/github",
		"active": true
	},
	"redirect_url": "https://radar.internal.example.com/setup/github-app",
	"callback_urls": ["https://radar.internal.example.com/auth/callback"],
	"request_oauth_on_install": false,
	"setup_on_update": false,
	"default_permissions": {
		"metadata": "read",
		"pull_requests": "read",
		"checks": "read",
		"statuses": "read",
		"members": "read"
	},
	"default_events": [
		"pull_request",
		"pull_request_review",
		"pull_request_review_comment",
		"pull_request_review_thread",
		"check_suite",
		"check_run",
		"status"
	]
}
